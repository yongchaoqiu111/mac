# 加密密钥配置文件模板
# 
# 使用方法：
# 1. 复制此文件为 .env（不要提交到Git）
# 2. 填入真实的密钥值
# 3. 在代码中加载：from dotenv import load_dotenv; load_dotenv()

# 客户端加密密钥（32字节 = 256位）
# 可以是用hex编码的64字符，或直接字符串
CLIENT_ENCRYPTION_KEY=ClientWallet2026SecureKey32B!!!!

# 服务器加密密钥（32字节 = 256位）
SERVER_ENCRYPTION_KEY=ServerWallet2026SecureKey32B!!!!

# 固定密码（用于客服登录验证）
FIXED_PASSWORD=customer_service_2026

# ==================== 安全提示 ====================
# ⚠️  严禁将此文件提交到版本控制系统
# ⚠️  生产环境建议使用云服务商的密钥管理服务（AWS KMS / Azure Key Vault）
# ⚠️  定期轮换密钥（建议每30天）
# ⚠️  使用chmod 600保护此文件权限
